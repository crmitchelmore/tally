{
  "name": "tally-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "preinstall": "[ -n \"${npm_config_user_agent%%bun*}\" ] || exit 0 && echo 'Use bun, not npm/yarn/pnpm' && exit 1",
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:dev": "CONVEX_DEPLOYMENT=$CONVEX_DEPLOYMENT_DEV playwright test --grep @authenticated",
    "test:e2e:api": "playwright test --grep @api"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.24",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-logs": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "@sentry/nextjs": "^11.11.0",
    "convex": "^1.49.0",
    "next": "^16.4.5",
    "posthog-js": "^1.446.3",
    "posthog-node": "^5.62.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "swr": "^2.5.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.6.2",
    "convex-test": "0.0.67",
    "debug-bridge-browser": "^0.2.2",
    "eslint": "10",
    "eslint-config-next": "^16.4.5",
    "postcss": "^8.5.32",
    "tailwindcss": "4",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "postcss": "^8.5.32"
  }
}
